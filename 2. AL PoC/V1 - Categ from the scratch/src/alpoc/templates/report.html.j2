<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{
  color-scheme: light;
  --bg:#f9f9f7; --surface:#fcfcfb; --surface-2:#f3f2ee; --ink:#0b0b0b; --ink-2:#52514e; --muted:#898781;
  --line:#e1e0d9; --accent:#2a78d6; --comp:#eb6834; --good:#006300; --good-bg:#e6f4e6; --warn-bg:#fdf3dc;
  --bad:#b42f2f; --bad-bg:#fbe9e9; --pend-bg:#ecebe6; --chip:#ecebe6; --ring:rgba(11,11,11,.10);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --ink:#ffffff; --ink-2:#c3c2b7; --muted:#898781;
    --line:#2c2c2a; --accent:#3987e5; --comp:#d95926; --good:#0ca30c; --good-bg:#12301a; --warn-bg:#3a2f12;
    --bad:#e66767; --bad-bg:#3a1a1a; --pend-bg:#2a2a28; --chip:#2a2a28; --ring:rgba(255,255,255,.10);
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0d0d0d; --surface:#1a1a19; --surface-2:#232321; --ink:#ffffff; --ink-2:#c3c2b7; --muted:#898781;
  --line:#2c2c2a; --accent:#3987e5; --comp:#d95926; --good:#0ca30c; --good-bg:#12301a; --warn-bg:#3a2f12;
  --bad:#e66767; --bad-bg:#3a1a1a; --pend-bg:#2a2a28; --chip:#2a2a28; --ring:rgba(255,255,255,.10);
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:14px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--accent)}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}
header{background:var(--surface);border-bottom:1px solid var(--line)}
header .wrap{padding-top:20px;padding-bottom:0}
h1{font-size:22px;margin:0 0 2px}
.sub{color:var(--ink-2);margin:0 0 14px}
.banner{background:var(--warn-bg);border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin:0 0 14px;font-size:13px}
nav.tabs{display:flex;gap:4px}
nav.tabs button{font:inherit;font-weight:600;background:none;border:0;border-bottom:3px solid transparent;color:var(--ink-2);
  padding:10px 12px;cursor:pointer}
nav.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
main .wrap{padding-top:22px;padding-bottom:60px}
section.panel[hidden]{display:none}
h2{font-size:18px;margin:30px 0 8px}
h3{font-size:15px;margin:22px 0 6px}
p{margin:6px 0 10px;max-width:820px}
.muted{color:var(--muted)} .ink2{color:var(--ink-2)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:820px){.g2,.g4{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.g2,.g4{grid-template-columns:1fr}}
.tile .v{font-size:26px;font-weight:600}
.tile .l{color:var(--ink-2);font-size:12.5px}
.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;counter-reset:s}
@media (max-width:820px){.flow{grid-template-columns:1fr 1fr}}
.flow .st{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px;position:relative}
.flow .st b{display:block;font-size:13px}
.flow .st span{font-size:12.5px;color:var(--ink-2)}
.flow .st .n{position:absolute;top:8px;right:10px;font-size:11px;color:var(--muted)}
.flow .st.m1{border-left:3px solid var(--accent)} .flow .st.m2{border-left:3px solid var(--comp)}
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:12.5px}
th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{position:sticky;top:0;background:var(--surface-2);font-weight:600;cursor:pointer;white-space:nowrap;user-select:none}
th.nosort{cursor:default}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr:last-child td{border-bottom:0}
.chip{display:inline-block;padding:1px 8px;border-radius:99px;background:var(--chip);font-size:11.5px;white-space:nowrap}
.st-PASS{background:var(--good-bg);color:var(--good)} .st-FAIL{background:var(--bad-bg);color:var(--bad)}
.st-PARTIAL{background:var(--warn-bg)} .st-PENDING{background:var(--pend-bg);color:var(--ink-2)}
.fig{background:#fcfcfb;border:1px solid var(--line);border-radius:10px;padding:6px;margin:0}
.fig img{display:block;width:100%;height:auto}
.fig figcaption{font-size:12px;color:#52514e;padding:4px 6px 2px}
.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);
  border-radius:10px;padding:12px 14px;position:sticky;top:0;z-index:5}
.controls label{font-weight:600}
.controls select{font:inherit;padding:7px 10px;border-radius:8px;border:1px solid var(--line);background:var(--surface-2);
  color:var(--ink);max-width:100%;min-width:0;flex:1 1 380px}
.node-head{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:baseline;margin:18px 0 6px}
.node-head h2{margin:0}
ul.ins{margin:6px 0 0;padding-left:18px} ul.ins li{margin:4px 0}
.skugrp{margin:14px 0 20px}
.sku{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface);margin:8px 0}
@media (max-width:620px){.sku{grid-template-columns:1fr}}
.sku > div{padding:10px 12px}
.sku .comp{border-right:1px solid var(--line)}
.sku .who{font-size:11px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;display:flex;gap:6px;align-items:center}
.sku .dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.sku .t{font-weight:600;font-size:13px;display:block;margin-bottom:4px}
.sku .meta{font-size:12px;color:var(--ink-2)}
.sku .scores{grid-column:1/-1;background:var(--surface-2);font-size:12px;color:var(--ink-2);border-top:1px solid var(--line);padding:6px 12px}
dl.lab{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;margin:6px 0;font-size:13px}
dl.lab dt{font-weight:600}
dl.lab dd{margin:0;color:var(--ink-2)}
details{margin:8px 0} summary{cursor:pointer;font-weight:600}
.legend-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px;vertical-align:-1px}
footer{color:var(--muted);font-size:12px;padding:30px 0}
@media print{
  header nav, .controls{display:none}
  section.panel[hidden]{display:block}
  .node-sec[hidden]{display:none}
  .node-sec{break-before:page}
}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <h1>{{ title }}</h1>
    <p class="sub">Where {{ comp }} carries product archetypes and attribute variants that Staples lacks, and which of them Staples could add through its marketplace without cannibalising its own assortment. Generated {{ date }}.</p>
    <div class="banner"><b>Provisional PoC run.</b> Attributes come from the local rules + embedding instrument (no LLM key available);
      style, vibe tags and the Design-Forward Index still need human validation; thresholds are weakly supervised, not yet calibrated with Pat.
      All figures are shares within a convenience sample, never absolute market sizes.</div>
    <nav class="tabs" role="tablist">
      <button role="tab" data-tab="method" aria-selected="true">Approach &amp; Methodology</button>
      <button role="tab" data-tab="nodes" aria-selected="false">Node-Level Analysis</button>
    </nav>
  </div>
</header>

<main><div class="wrap">

<!-- ======================================================= TAB 1 -->
<section class="panel" id="tab-method">
  <h2 style="margin-top:0">The question</h2>
  <p>Staples wants to grow its marketplace with <b>core-adjacent</b> products: design and lifestyle extensions of things it already sells (the “White Chair” idea: an aesthetic-first chair next to Staples' ergonomic range), without taking sales from its own first-party assortment. Using only external data, this PoC asks, for each granular Staples shelf:</p>
  <ul>
    <li><b>Where are the gaps?</b> Which archetypes and attribute values (colour, material, style, price band, features) are more common at {{ comp }} than at Staples?</li>
    <li><b>Are they safe and on-brand?</b> Would a product take a sale from a Staples item, does it fit Staples' customer, and is it priced to trade up or to undercut?</li>
    <li><b>What should be added?</b> Named archetypes with example products and notes on brands and sellers.</li>
  </ul>

  <h2>At a glance</h2>
  <div class="grid g4">
    <div class="card tile"><div class="v">{{ "{:,}".format(tiles.comp_mapped) }}</div><div class="l">{{ comp }} products placed on a Staples shelf (of {{ "{:,}".format(tiles.comp_fam) }})</div></div>
    <div class="card tile"><div class="v">{{ tiles.scored }}</div><div class="l">shelves fully analysed (+{{ tiles.thin }} thin, descriptive only)</div></div>
    <div class="card tile"><div class="v">{{ tiles.shortlisted }}</div><div class="l">archetypes recommended across shelves</div></div>
    <div class="card tile"><div class="v">{{ "{:,}".format(tiles.backlog) }}</div><div class="l">{{ comp }} products with no Staples shelf (new-node backlog)</div></div>
  </div>

  <h2>How we approached it</h2>
  <p>Twelve stages. The first four make the comparison fair; the two methods then score every archetype independently; a shared safety gate and a fused ranking produce the recommendations.</p>
  <div class="flow">
    <div class="st"><span class="n">S0</span><b>Ingest &amp; clean</b><span>Parse prices and Staples' spec sheets; strip customer reviews (personal data) from {{ comp }} text.</span></div>
    <div class="st"><span class="n">S1</span><b>Product families</b><span>Staples lists each colour as its own SKU; group them so both sides count products the same way.</span></div>
    <div class="st"><span class="n">S2</span><b>Shelves (analysis nodes)</b><span>Staples leaf categories; large ones split by Staples' own type facet (a pseudo-L5).</span></div>
    <div class="st"><span class="n">S3</span><b>Map {{ comp }} products</b><span>Each product placed on a Staples shelf by a classifier trained on Staples' own products, or sent to the backlog.</span></div>
    <div class="st"><span class="n">S4–S5</span><b>Attributes</b><span>Colour, material, style, features, use context, vibe, dimensions, and a Design-Forward Index; checked against Staples specs.</span></div>
    <div class="st"><span class="n">S6</span><b>Archetypes</b><span>A small grid of the most informative attributes per shelf; thin cells merge upward; checked against clustering.</span></div>
    <div class="st m1"><span class="n">S7</span><b>Method 1: vector view → VOS</b><span>Empty space near Staples, fit, visible difference, and cannibalisation risk, per product and archetype.</span></div>
    <div class="st m2"><span class="n">S8</span><b>Method 2: attribute view → TG</b><span>Share, price, colour, material/style and design-forward gaps per archetype and attribute value.</span></div>
    <div class="st"><span class="n">S9</span><b>Gate + fused re-rank</b><span>Drop archetypes that mostly substitute or undercut Staples; rank the rest by both scores together.</span></div>
    <div class="st"><span class="n">S10</span><b>Products &amp; sellers</b><span>Diverse example products per recommendation, each shown next to its nearest Staples product.</span></div>
    <div class="st"><span class="n">S11</span><b>Outputs</b><span>This report, PNG figures and CSV tables.</span></div>
    <div class="st"><span class="n">QA</span><b>Quality gates</b><span>Eight checks (below); failures are reported, not hidden.</span></div>
  </div>

  <h2>Data coverage</h2>
  <p>{{ comp }}'s sample overlaps Staples mainly in Chairs &amp; Seating and Desks, so those are the shelves analysed today. Scope is decided by the data on every run: when new categories or competitors are added, the same pipeline picks up whatever shelves have enough products on both sides.</p>
  <div class="grid g2">
    <figure class="fig"><img alt="Families per analysis node, Staples vs {{ comp }}" src="{{ ov.coverage }}"><figcaption>Shelves with products on both sides. Thin = fewer than {{ cfg.nodes.min_families_scored }} families on one side.</figcaption></figure>
    <div>
      <h3 style="margin-top:0">New-node backlog ({{ comp }} products with no Staples shelf)</h3>
      <div class="tbl-wrap"><table class="sortable"><thead><tr><th>{{ comp }} page</th><th class="num">No Staples shelf for the page</th><th class="num">Too far from any candidate shelf</th></tr></thead><tbody>
      {% for r in backlog %}<tr><td>{{ r.page }}</td><td class="num">{{ r.none_page }}</td><td class="num">{{ r.none_far }}</td></tr>{% endfor %}
      </tbody></table></div>
      <p class="muted" style="font-size:12.5px">{{ n_staples_only }} Staples shelves have no {{ comp }} products in this sample (for example Labels, Shipping) and are not scored.</p>
    </div>
  </div>

  <h2>The two methods</h2>
  <p>Each method keeps its own final score. Neither is blended into the other; they meet only in the final ranking.</p>
  <div class="grid g2">
    <div class="card" style="border-left:3px solid var(--accent)">
      <h3 style="margin-top:0">Method 1 · vector view → VOS</h3>
      <p class="ink2">Every product becomes a “card” (same template on both sides: type, colour, material, style, features, vibe, use; no price) and is embedded with <code>{{ encoder }}</code>.</p>
      <dl class="lab">
        <dt>VW</dt><dd>Vector Whitespace: how few Staples products sit near this product, after balancing sample sizes.</dd>
        <dt>AAS</dt><dd>Fit with Staples: closeness to Staples' catalogue on this L2 plus overlap with the use contexts Staples serves.</dd>
        <dt>CRS</dt><dd>Cannibalisation risk: functional similarity to the nearest Staples products. Ignores price and looks by design.</dd>
        <dt>AD</dt><dd>Aesthetic delta: how different the colour, material, style and vibe are from the nearest Staples product.</dd>
        <dt>PPR</dt><dd>Price ratio to the nearest Staples products. Used only in the labels, never in a score.</dd>
      </dl>
      <p><code>VOS = 100 × [{{ cfg.vector.vos_weights.vw }}·pct(VW) + {{ cfg.vector.vos_weights.aas }}·AAS/100 + {{ cfg.vector.vos_weights.ad }}·pct(AD)] × (1 − CRS/100)</code></p>
    </div>
    <div class="card" style="border-left:3px solid var(--comp)">
      <h3 style="margin-top:0">Method 2 · attribute view → TG</h3>
      <p class="ink2">Archetypes are compared as shares of each retailer's shelf, so a sample is compared with a sample, never with a census.</p>
      <dl class="lab">
        <dt>LSR</dt><dd>Log share ratio: how over-represented the archetype is at {{ comp }}. Defined even when Staples has none; shrunk when not statistically credible.</dd>
        <dt>PPG</dt><dd>Price position gap: distance between the two price distributions (↑ = {{ comp }} priced higher).</dd>
        <dt>CG</dt><dd>Colour gap: difference in colour-tone mix.</dd>
        <dt>MSG</dt><dd>Material &amp; style gap.</dd>
        <dt>DFG</dt><dd>Design-forward gap: {{ comp }} median DFI minus Staples median DFI.</dd>
      </dl>
      <p><code>TG = 100 × [{{ cfg.gaps.tg_weights.lsr }}·pct(LSR) + {{ cfg.gaps.tg_weights.ppg }}·pct(PPG) + {{ cfg.gaps.tg_weights.cg }}·pct(CG) + {{ cfg.gaps.tg_weights.msg }}·pct(MSG) + {{ cfg.gaps.tg_weights.dfg }}·pct(DFG)]</code></p>
    </div>
  </div>

  <h3>Decision labels (per {{ comp }} product)</h3>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort">Label</th><th class="nosort">Meaning</th><th class="nosort">Action</th><th class="nosort num">Products</th></tr></thead><tbody>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>CURATE</td><td>Low cannibalisation, good fit: true whitespace.</td><td>Approve</td><td class="num">{{ label_counts.get('CURATE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>STYLE-EXTENSION</td><td>Does the same job as a Staples product but in a colour, material or style Staples lacks (the “flavours” case).</td><td>Approve</td><td class="num">{{ label_counts.get('STYLE-EXTENSION',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#1baf7a"></span>TRADE-UP</td><td>Same job, priced ≥ {{ cfg.vector.ppr_tradeup }}× higher, with a visible upgrade (design or material).</td><td>Approve, margin note</td><td class="num">{{ label_counts.get('TRADE-UP',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#eda100"></span>REVIEW</td><td>Middle band of cannibalisation risk.</td><td>Pat's calibration queue</td><td class="num">{{ label_counts.get('REVIEW',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#eda100"></span>EDGE</td><td>Low risk, weaker fit with Staples' customer.</td><td>Hold for phase 2</td><td class="num">{{ label_counts.get('EDGE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>SUBSTITUTE</td><td>Same job, same look, similar price: pure diversion.</td><td>Reject</td><td class="num">{{ label_counts.get('SUBSTITUTE',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>UNDERCUT</td><td>Same job, priced below {{ cfg.vector.ppr_undercut }}× the Staples product: resets the price point.</td><td>Hard reject</td><td class="num">{{ label_counts.get('UNDERCUT',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>OFF-BRAND</td><td>Poor fit with Staples' catalogue and customers.</td><td>Reject</td><td class="num">{{ label_counts.get('OFF-BRAND',0) }}</td></tr>
    <tr><td><span class="legend-dot" style="background:#4a3aa7"></span>EXCLUDE</td><td>Near-identical to a product Staples already carries.</td><td>Not a gap</td><td class="num">{{ label_counts.get('EXCLUDE',0) }}</td></tr>
  </tbody></table></div>

  <h3>From two scores to one list</h3>
  <p><b>1 · Safety gate.</b> An archetype qualifies only if at least {{ "{:.0%}".format(cfg.integration.safe_share_min) }} of its {{ comp }} products are approvable and fewer than {{ "{:.0%}".format(cfg.integration.reject_share_max) }} substitute or undercut Staples. The gate applies to both methods, because TG alone cannot see cannibalisation.
  <b>2 · Fused re-rank.</b> Within a shelf, <code>Final = {{ cfg.integration.w_vos }}·rank(VOS) + {{ cfg.integration.w_tg }}·rank(TG)</code>.
  <b>3 · Agreement tier.</b> <i>Strong</i> = top third in both methods; <i>Gap-led</i> = TG only (a real gap the vector view finds crowded or close to Staples); <i>Vector-led</i> = VOS only (whitespace the attribute grid does not capture); <i>Weak</i> = neither. Up to {{ cfg.integration.shortlist_n }} non-Weak archetypes per shelf are recommended.</p>

  <h2>Quality gates</h2>
  <div class="tbl-wrap"><table><thead><tr><th class="nosort">Gate</th><th class="nosort">What is checked</th><th class="nosort">Result</th><th class="nosort">Target</th><th class="nosort">Status</th><th class="nosort">Note</th></tr></thead><tbody>
  {% for g in gates %}<tr><td><b>{{ g.name }}</b></td><td>{{ g.metric }}</td><td>{{ g.value }}</td><td style="white-space:nowrap">{{ g.target }}</td><td><span class="chip st-{{ g.status }}">{{ g.status }}</span></td><td class="ink2">{{ g.note }}</td></tr>{% endfor %}
  </tbody></table></div>
  <details><summary>Extraction accuracy per field (text instrument vs Staples specs)</summary>
    <div class="grid g2" style="margin-top:10px">
    {% for key, img in ov.items() if key.startswith('acc_') and img %}<figure class="fig"><img alt="Extractor accuracy" src="{{ img }}"><figcaption>{{ key[4:].replace('_',' ') }}</figcaption></figure>{% endfor %}</div>
  </details>
  <details><summary>Encoder bake-off and calibration</summary>
    <div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th class="nosort">Encoder</th><th class="nosort num">Staples leave-one-out k-NN</th><th class="nosort num">In-scope kept</th><th class="nosort num">Out-of-scope rejected</th><th class="nosort num">NONE threshold</th></tr></thead><tbody>
    {% for b in bakeoff %}<tr><td>{{ b.model }}{% if b.model == encoder %} <span class="chip st-PASS">chosen</span>{% endif %}</td><td class="num">{{ "{:.1%}".format(b.staples_loo_knn) }}</td><td class="num">{{ "{:.1%}".format(b.in_scope_recall) }}</td><td class="num">{{ "{:.1%}".format(b.out_scope_rejection) }}</td><td class="num">{{ "%.3f"|format(b.tau_none) }}</td></tr>{% endfor %}
    </tbody></table></div>
    <div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th class="nosort">L2</th><th class="nosort">CRS calibration</th><th class="nosort num">AUC</th><th class="nosort num">AAS low / high</th></tr></thead><tbody>
    {% for l2, c in calib.items() %}<tr><td>{{ l2 }}</td><td>{{ c.method }} ({{ c.n_pos }} positive, {{ c.n_neg }} negative Staples pairs)</td><td class="num">{{ "%.2f"|format(c.auc) if c.auc is not none else "–" }}</td><td class="num">{{ "%.0f"|format(thresholds[l2].aas_low) }} / {{ "%.0f"|format(thresholds[l2].aas_high) }}</td></tr>{% endfor %}
    </tbody></table></div>
  </details>

  <h2>Assumptions and caveats</h2>
  <ul>
    <li>Everything Staples.com sells counts as existing assortment for cannibalisation, including third-party brands it retails.</li>
    <li>The {{ comp }} data is a convenience sample (pages that scraped successfully). Every number is a within-sample share with a credibility check; nothing here estimates market size or demand.</li>
    <li>{{ comp }} consumer and Professional pages are pooled. Prices are list prices at crawl time.</li>
    <li>{{ comp }}'s “vendor” is usually a house brand, not a manufacturer: those products are recommendations to <i>source the archetype</i>, not to recruit that brand.</li>
    <li>Category-specific vocabularies, the page crosswalk and the house-brand list are drafts awaiting review. Shelves in L2s without a reviewed configuration are marked provisional.</li>
  </ul>
</section>

<!-- ======================================================= TAB 2 -->
<section class="panel" id="tab-nodes" hidden>
  <div class="controls">
    <label for="nodeSel">Shelf</label>
    <select id="nodeSel">
      {% for l2 in nodes|map(attribute='l2')|unique %}<optgroup label="{{ l2 }}">
        {% for n in nodes if n.l2 == l2 %}<option value="{{ n.id }}">{{ n.label }}{% if n.status == 'thin' %} (thin: descriptive only){% endif %}</option>{% endfor %}
      </optgroup>{% endfor %}
    </select>
  </div>

  {% for s in sections %}
  <article class="node-sec" id="n-{{ s.id }}" hidden>
    <div class="node-head">
      <h2>{{ s.label }}</h2>
      {% if s.status == 'thin' %}<span class="chip st-PENDING">thin shelf: descriptive only</span>{% endif %}
      {% if s.provisional %}<span class="chip st-PARTIAL">provisional configuration</span>{% endif %}
    </div>
    <p class="ink2">Staples {{ "{:,}".format(s.ns) }} families · {{ comp }} {{ "{:,}".format(s.nc) }} families · {{ "{:.0%}".format(s.lowconf) }} of mapped {{ comp }} products low-confidence
      {% if s.rho is not none %} · method agreement (Spearman VOS↔TG) {{ "%.2f"|format(s.rho) }}{% endif %}
      {% if s.facets %} · archetype grid: {{ s.facets }}{% endif %}</p>

    <h3>Key insights</h3>
    <div class="card"><ul class="ins">{% for i in s.insights %}<li>{{ i }}</li>{% endfor %}</ul></div>

    <h3>Coverage</h3>
    <div class="grid g2">
      {% if s.figs.price %}<figure class="fig"><img alt="Price-band coverage" src="{{ s.figs.price }}"><figcaption>Share of each retailer's families per price band. “gap” = {{ comp }} share credibly higher.</figcaption></figure>{% endif %}
      <figure class="fig"><img alt="Design-forward distribution" src="{{ s.figs.dfi }}"><figcaption>Design-Forward Index, pooled percentile of a design-vs-utility contrast (provisional until human validation).</figcaption></figure>
      {% if s.figs.jsd %}<figure class="fig"><img alt="Attribute divergence" src="{{ s.figs.jsd }}"><figcaption>Higher = the two retailers' mixes differ more on that attribute.</figcaption></figure>{% endif %}
      {% if s.figs.gaps %}<figure class="fig"><img alt="Attribute value gaps" src="{{ s.figs.gaps }}"><figcaption>Credible gaps only (≥ 90% posterior probability); fields that failed validation are excluded.</figcaption></figure>{% endif %}
    </div>

    <h3>Attribute-level gaps</h3>
    <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Attribute</th><th>Value</th><th class="num">{{ comp }}</th><th class="num">Staples</th><th class="num">Gap</th><th class="num">Credibility</th></tr></thead><tbody>
    {% for g in s.gaps %}<tr><td>{{ g.attr }}{% if g.desc %} <span class="chip">descriptive only</span>{% endif %}</td><td>{{ g.val }}</td><td class="num">{{ g.sc }}</td><td class="num">{{ g.ss }}</td><td class="num">{{ g.delta }}</td><td class="num">{{ g.cred }}</td></tr>{% endfor %}
    </tbody></table></div>
    <p class="muted" style="font-size:12px">Credibility = posterior probability that {{ comp }}'s share is higher. Values near 0% mean Staples is credibly deeper.</p>

    {% if s.status == 'scored' %}
    <h3>Final recommendations</h3>
    <div class="grid g2">
      {% if s.figs.agreement %}<figure class="fig"><img alt="TG versus VOS" src="{{ s.figs.agreement }}"><figcaption>#n = recommended, by fused rank. Hollow = failed the safety gate.</figcaption></figure>{% endif %}
      {% if s.figs.labelmix %}<figure class="fig"><img alt="Label mix per archetype" src="{{ s.figs.labelmix }}"><figcaption>Share of each archetype's {{ comp }} products per decision group.</figcaption></figure>{% endif %}
    </div>
    <div class="tbl-wrap" style="margin-top:10px"><table class="sortable"><thead><tr><th class="num">Rank</th><th>Archetype</th><th>Agreement</th><th class="num">VOS</th><th class="num">TG</th><th class="num">Final</th><th class="num">Top-5 stability (TG / VOS)</th><th>Definition</th></tr></thead><tbody>
    {% for r in s.final %}<tr><td class="num">{{ r.rank }}</td><td>{% if r.short %}<b>{{ r.name }}</b> <span class="chip st-PASS">recommended</span>{% else %}{{ r.name }}{% endif %}</td><td>{{ r.tier }}</td><td class="num">{{ r.vos }}</td><td class="num">{{ r.tg }}</td><td class="num">{{ r.final }}</td><td class="num">{{ r.stab }}</td><td class="ink2">{{ r.def }}</td></tr>
    {% else %}<tr><td colspan="8" class="muted">No archetype passed the safety gate.</td></tr>{% endfor %}
    </tbody></table></div>

    <h3>SKU recommendations</h3>
    {% for g in s.skus %}<div class="skugrp">
      <b>#{{ g.rank }} · {{ g.name }}</b> <span class="chip">{{ g.tier }}</span>
      {% for c in g.cards %}{% include 'card.html.j2' %}{% endfor %}
    </div>{% else %}<p class="muted">No shortlisted archetype on this shelf.</p>{% endfor %}

    {% if s.style_ext %}<details><summary>STYLE-EXTENSION list: {{ s.style_ext|length }} colour, material or style variants of existing Staples products</summary>
      {% for c in s.style_ext %}{% include 'card.html.j2' %}{% endfor %}
    </details>{% endif %}

    <h3>Vendor / seller view</h3>
    <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Display brand</th><th class="num">Approvable products</th><th class="num">Archetypes</th><th>Recruit path</th></tr></thead><tbody>
    {% for v in s.vendors %}<tr><td>{{ v.brand }}{% if v.on %} <span class="chip st-PASS">sells on Staples</span>{% endif %}{% if v.house %} <span class="chip">{{ comp }} house brand</span>{% endif %}</td><td class="num">{{ v.products }}</td><td class="num">{{ v.arch }}</td><td class="ink2">{{ v.path }}</td></tr>
    {% else %}<tr><td colspan="4" class="muted">No approvable products in recommended archetypes.</td></tr>{% endfor %}
    </tbody></table></div>

    <details><summary>Method 1 · vector view: all archetypes</summary>
      {% if s.figs.decision %}<figure class="fig" style="margin:10px 0"><img alt="Decision scatter" src="{{ s.figs.decision }}"><figcaption>Every {{ comp }} product on this shelf; lines = CRS {{ cfg.vector.crs_low }}/{{ cfg.vector.crs_high }} and AAS thresholds.</figcaption></figure>{% endif %}
      <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Archetype</th><th class="num">Staples</th><th class="num">{{ comp }}</th><th class="num">VW</th><th class="num">AAS</th><th class="num">AD</th><th class="num">CRS</th><th class="num">PPR</th><th class="num">Safe share</th><th class="num">VOS</th><th>Gate</th></tr></thead><tbody>
      {% for r in s.m1 %}<tr><td>{{ r.name }}</td><td class="num">{{ r.ns }}</td><td class="num">{{ r.nc }}</td><td class="num">{{ r.vw }}</td><td class="num">{{ r.aas }}</td><td class="num">{{ r.ad }}</td><td class="num">{{ r.crs }}</td><td class="num">{{ r.ppr }}</td><td class="num">{{ r.safe }}</td><td class="num">{{ r.vos }}</td><td>{{ r.elig }}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    <details><summary>Method 2 · attribute view: all archetypes</summary>
      <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Archetype</th><th class="num">Staples share</th><th class="num">{{ comp }} share</th><th class="num">LSR</th><th class="num">Credibility</th><th>Flag</th><th class="num">PPG</th><th class="num">CG</th><th class="num">MSG</th><th class="num">DFG</th><th class="num">TG</th><th class="num">TG (original weights)</th><th>Colours Staples lacks</th></tr></thead><tbody>
      {% for r in s.m2 %}<tr><td>{{ r.name }}</td><td class="num">{{ r.ps }}</td><td class="num">{{ r.pc }}</td><td class="num">{{ r.lsr }}</td><td class="num">{{ r.cred }}</td><td>{{ r.flag }}</td><td class="num">{{ r.ppg }}</td><td class="num">{{ r.cg }}</td><td class="num">{{ r.msg }}</td><td class="num">{{ r.dfg }}</td><td class="num">{{ r.tg }}</td><td class="num">{{ r.tgo }}</td><td class="ink2">{{ r.miss }}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    <details><summary>Excluded archetypes ({{ s.excluded|length }})</summary>
      <div class="tbl-wrap"><table class="sortable"><thead><tr><th>Archetype</th><th>Why excluded</th><th>Agreement</th><th class="num">VOS</th><th class="num">TG</th></tr></thead><tbody>
      {% for r in s.excluded %}<tr><td>{{ r.name }}</td><td class="ink2">{{ r.reason }}</td><td>{{ r.tier }}</td><td class="num">{{ r.vos }}</td><td class="num">{{ r.tg }}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    {% else %}
    <p class="muted">Fewer than {{ cfg.nodes.min_families_scored }} families on one side: shown descriptively; archetypes and recommendations are not scored for this shelf.</p>
    {% endif %}
  </article>
  {% endfor %}
</section>

<footer>Staples Marketplace assortment PoC · LatentView · method: methodology.md v1.2 · encoder {{ encoder }} · extraction backend: {{ backend }}.</footer>
</div></main>

<script>
(function(){
  var tabs=document.querySelectorAll('nav.tabs button');
  function openTab(name){
    tabs.forEach(function(b){b.setAttribute('aria-selected', b.dataset.tab===name ? 'true':'false');});
    document.getElementById('tab-method').hidden = name!=='method';
    document.getElementById('tab-nodes').hidden = name!=='nodes';
    try{localStorage.setItem('alpoc-tab',name);}catch(e){}
  }
  tabs.forEach(function(b){b.addEventListener('click',function(){openTab(b.dataset.tab);});});
  var sel=document.getElementById('nodeSel');
  function showNode(id){
    document.querySelectorAll('.node-sec').forEach(function(s){s.hidden = s.id!=='n-'+id;});
    if(sel.value!==id) sel.value=id;
    try{localStorage.setItem('alpoc-node',id); history.replaceState(null,'','#'+id);}catch(e){}
  }
  sel.addEventListener('change',function(){showNode(sel.value);});
  var start=(location.hash||'').slice(1), tab=null, node=null;
  try{tab=localStorage.getItem('alpoc-tab'); node=localStorage.getItem('alpoc-node');}catch(e){}
  if(start && document.getElementById('n-'+start)){node=start; tab='nodes';}
  if(!node || !document.getElementById('n-'+node)) node=sel.options[0] ? sel.options[0].value : null;
  if(node) showNode(node);
  openTab(tab==='nodes' ? 'nodes' : 'method');
  // sortable tables
  document.querySelectorAll('table.sortable th').forEach(function(th){
    th.addEventListener('click',function(){
      var table=th.closest('table'), idx=Array.prototype.indexOf.call(th.parentNode.children,th);
      var body=table.tBodies[0], rows=Array.prototype.slice.call(body.rows);
      var asc = th.dataset.dir!=='asc'; th.dataset.dir = asc ? 'asc':'desc';
      function val(r){var t=(r.cells[idx]||{}).textContent||''; var n=parseFloat(t.replace(/[$,%+↑↓ ]/g,'')); return isNaN(n)? t.toLowerCase(): n;}
      rows.sort(function(a,b){var x=val(a),y=val(b); if(x===y) return 0; return (x>y?1:-1)*(asc?1:-1);});
      rows.forEach(function(r){body.appendChild(r);});
    });
  });
})();
</script>
</body>
</html>
